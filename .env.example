PORT=3000
NODE_ENV=development

# Segredo aleatório com pelo menos 32 caracteres; nunca commitar.
JWT_SECRET=
# Duração inteira positiva seguida de s, m, h ou d.
JWT_EXPIRES_IN=

# HTTPS. Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Bucket privado separado de corretor-midia para documentos; não habilite acesso público.
# Private bucket for tenant/owner/lease documents (test):
R2_DOCUMENTS_BUCKET=corretor-documentos-test

# Apenas para npm run bootstrap:admin, depois da migration. Remova após o uso.
# Não são exigidas para iniciar a API normalmente.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_WHATSAPP=

# Origens exatas do front, sem barra final; separar por vírgula. HTTPS em produção.
ALLOWED_ORIGINS=http://localhost:5173


