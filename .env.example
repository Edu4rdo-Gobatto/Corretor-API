PORT=3000
NODE_ENV=development

# Segredo aleatório com pelo menos 32 caracteres; nunca commitar.
JWT_SECRET=
# Duração inteira positiva seguida de s, m, h ou d.
JWT_EXPIRES_IN=

# HTTPS. Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

ALLOWED_ORIGINS=

DATABASE_URL=""

BOOTSTRAP_ADMIN_NAME=''
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=''
BOOTSTRAP_ADMIN_WHATSAPP=
