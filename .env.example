PORT=3000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
ALLOWED_ORIGINS=https://localhost:5173

# Mídia pública; nunca usar bucket de contratos/documentos.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_REQUEST_TIMEOUT_MS=30000
R2_CONNECTION_TIMEOUT_MS=5000

# Meu Drive do dono por OAuth (escopo drive.file): configure as quatro juntas ou nenhuma.
# ID e segredo vêm do cliente OAuth "App para computador" no Google Cloud; o refresh token e a pasta raiz são
# impressos por `npm run drive:autorizar`. Passo a passo em docs/2026-10-14-tarefa-google-drive.md.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Aviso de novo contato por e-mail (Resend): configure as duas juntas; vazias, o aviso fica desligado.
# O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
AVISO_EMAIL_REMETENTE=

# Apenas durante o corte do legado, em arquivos privados fora do Git.
MIGRACAO_BACKUP_ARQUIVO=
MIGRACAO_COMPLEMENTOS_ARQUIVO=
# Chave original antiga; não necessária no runtime novo.
LEADS_ENCRYPTION_KEY=

# Apenas bootstrap inicial; remover do ambiente depois do uso.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_WHATSAPP=
BOOTSTRAP_ADMIN_CPF=

# Somente para o teste de integração da migration (nunca no runtime): PostgreSQL 16 local sem TLS, por exemplo Docker.
TESTE_LOCAL_DATABASE_URL=
