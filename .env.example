# Copie para .env e substitua os campos vazios. Nenhum segredo real neste arquivo.
PORT=3000
NODE_ENV=development

# Somente Neon online. URL com usuário, senha, banco e sslmode=require.
# Parâmetros aceitos: sslmode e channel_binding, sem duplicatas.
DATABASE_URL=

# Segredo aleatório com pelo menos 32 caracteres; nunca commitar.
JWT_SECRET=
# Duração inteira positiva seguida de s, m, h ou d.
JWT_EXPIRES_IN=15m

# HTTPS. Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL pública HTTPS do bucket (r2.dev ou domínio próprio).
R2_PUBLIC_URL=

# Apenas para npm run bootstrap:admin, depois da migration. Remova após o uso.
# Não são exigidas para iniciar a API normalmente.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_WHATSAPP=

# Origens exatas do front, sem barra final; separar por vírgula. HTTPS em produção.
ALLOWED_ORIGINS=http://localhost:5173
